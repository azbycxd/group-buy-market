# Copy to deploy/.env.demo and replace every placeholder. Never commit the real file.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_API_KEY=replace-with-provider-api-key

# Public hostname resolved to the deployment server. Caddy obtains and renews
# the HTTPS certificate automatically.
DEMO_DOMAIN=demo.example.com

# The subnet and Caddy address must remain aligned with deploy/compose.yml.
DEMO_DOCKER_SUBNET=172.30.0.0/24
DEMO_CADDY_IP=172.30.0.250

# Enables the one-visitor interview page and POST /demo/session.
DEMO_ENABLED=true
DEMO_LEASE_TTL_SECONDS=1800
DEMO_IDLE_TIMEOUT_SECONDS=300
DEMO_DAILY_TOKEN_LIMIT=500000
# Public Compose always enables forwarded headers and trusts only the fixed
# Caddy container address. These values document the effective deployment
# settings; compose.yml enforces them rather than trusting arbitrary overrides.
DEMO_TRUST_PROXY_HEADERS=true
DEMO_TRUSTED_PROXY_IPS=172.30.0.250

# JWT accepted by the Agent HTTP API.
JWT_SECRET=replace-with-at-least-32-random-characters

# Credential HMAC for refund proposal confirmation.
ACTION_CONFIRM_SECRET=replace-with-at-least-32-random-characters

# Shared Agent-to-Java service JWT configuration. These exact AGENT_INTERNAL_*
# values are consumed by Java and mapped to JAVA_INTERNAL_* in the Agent.
AGENT_INTERNAL_JWT_SECRET=replace-with-at-least-32-random-characters
AGENT_INTERNAL_JWT_ISSUER=group-buy-agent-demo
AGENT_INTERNAL_JWT_AUDIENCE=group-buy-market-demo

DEMO_MYSQL_DATABASE=group_buy_market_demo
DEMO_MYSQL_USERNAME=group_buy_demo
DEMO_MYSQL_PASSWORD=replace-with-random-password
DEMO_MYSQL_ROOT_PASSWORD=replace-with-another-random-password

DEMO_RABBITMQ_USERNAME=group_buy_demo
DEMO_RABBITMQ_PASSWORD=replace-with-random-password
DEMO_RABBITMQ_VHOST=group-buy-demo

AGENT_REQUEST_TIMEOUT_SECONDS=25
JAVA_REFUND_TIMEOUT_SECONDS=5
JAVA_REFUND_RESULT_TIMEOUT_SECONDS=5
RAG_RERANK_THRESHOLD=0.85

# Optional tracing; disabled for the local demo unless explicitly configured.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=group-buy-agent-docker-demo
