OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example/v1
OPENAI_MODEL=your-model-name
OPENAI_API_KEY=your-api-key
FAKE_JAVA_BASE_URL=http://127.0.0.1:8000
# Leave JAVA_BASE_URL empty to keep using fake_java.
JAVA_BASE_URL=
JAVA_INTERNAL_JWT_SECRET=replace-with-the-shared-internal-service-secret
JAVA_INTERNAL_JWT_ISSUER=your-internal-token-issuer
JAVA_INTERNAL_JWT_AUDIENCE=your-java-service-audience
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=group-buy-agent
# CLI only. HTTP user identity always comes from the verified JWT sub claim.
AGENT_USER_ID=your-user-id
JWT_SECRET=replace-with-a-long-random-secret
ACTION_CONFIRM_SECRET=replace-with-a-separate-long-random-secret
# D2.1 same-sample exploratory threshold; not a generalized quality guarantee.
RAG_RERANK_THRESHOLD=0.85
